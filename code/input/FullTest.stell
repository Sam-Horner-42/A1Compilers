# Function identifiers are appended with : #

digit function:(digit param, duple isParam); # function declaration #

# String #
word name = "Sam Horner";
# integer #
digit pi = 3.14;

# main function #
digit main:() {
	
	print:("Hello World");
}

digit function:(digit param, duple isParam) {
	digit localParam;
	if (isParam){
		return param;
	} else {
		return param / 2;
		}
	return 0;
}

empty otherFunction:(){
	print:("Hello World");
}

empty iteration:() {
	digit iterator = 1;
	while(iterator < 10){
		print:("While");
		iterator = iterator + 1;
	}
}

duple comparisonFunction:(digit val1, digit val2){
	if (val1 > val2){
		return TRUE;
	} else {
		return FALSE;
	}
	if(val1 <= val2){
		print:("Less than equal");
	}
	if(val1 >= val2){
		print:("Greater than equal");
	}
	if(val1 != val2){
		print:("Not equal");
	}

}

bigdigit mathOperations:(){
	digit addition = 1 + 2;
	digit division = 4 / 2;
	digit multiplication = 2 * 2;
	digit subtraction = 4 - 2;
	digit exponent = 5^2;
	digit modulo = 10%2;
}



