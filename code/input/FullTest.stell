# Stelline Language Example Execution #
# Samuel Horner 040935005 #
# Function identifiers are appended with : #

empty function:(duple isParam); # function declaration #

# String #
word name = "Sam Horner";
# integer #
digit pi = 3.14;

empty compareFunction:(duple isParam) {
	if (isParam == TRUE){
		print:("isParam");
	} else {
		print:("not isParam");
	}
}

empty otherFunction:(){
	print:("Hello World");
}

empty comparisonFunction:(digit val1, digit val2){
	if (val1 > val2){
		print:("Val1 greater than val2");
	} else {
		print:("Val2 greater than val1");
	}
	if(val1 <= val2){
		print:("Less than equal");
	}
	if(val1 >= val2){
		print:("Greater than equal");
	}
	if(val1 != val2){
		print:("Not equal");
	}

}

empty mathOperations:(){
	digit addition = 1 + 2;
	digit division = 4 / 2;
	digit multiplication = 2 * 2;
	digit subtraction = 4 - 2;

	rad floatAddition = 1.2 + 2.7;
	rad floatDivision = 4.2 / 2.08;
	rad floatMultiplication = 2.7 * 2.78;
	rad floatSubtraction = 4.2 - 2.3;
}

# main function #
digit main:() {
	
	print:("Hello World");
	compareFunction:(TRUE);
	comparisonFunction:(20, 3);
	mathOperations:();
}

